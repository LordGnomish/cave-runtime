{
  "title": "cave-search",
  "uid": "cave-search",
  "tags": ["cave", "data-persistence", "search", "opensearch"],
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {"id": 1, "title": "Search ops/sec", "type": "graph", "targets": [{"expr": "rate(cave_search_search_total[5m])"}]},
    {"id": 2, "title": "Search latency p99 (ms)", "type": "graph", "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(cave_search_search_duration_seconds_bucket[5m]))) * 1000"}]},
    {"id": 3, "title": "Indexing rate (docs/sec)", "type": "graph", "targets": [{"expr": "rate(cave_search_index_docs_total[5m])"}]},
    {"id": 4, "title": "Doc count", "type": "stat", "targets": [{"expr": "cave_search_docs_total"}]},
    {"id": 5, "title": "Heap usage (bytes)", "type": "graph", "targets": [{"expr": "cave_search_heap_used_bytes"}]},
    {"id": 6, "title": "GC time (s)", "type": "graph", "targets": [{"expr": "rate(cave_search_gc_seconds_total[5m])"}]},
    {"id": 7, "title": "Search errors/sec", "type": "graph", "targets": [{"expr": "rate(cave_search_search_errors_total[5m])"}]},
    {"id": 8, "title": "Cluster health", "type": "stat", "targets": [{"expr": "cave_search_cluster_health"}]},
    {"id": 9, "title": "Shard count", "type": "stat", "targets": [{"expr": "cave_search_shards_total"}]},
    {"id": 10, "title": "Refresh latency p99 (ms)", "type": "graph", "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(cave_search_refresh_duration_seconds_bucket[5m]))) * 1000"}]}
  ]
}
