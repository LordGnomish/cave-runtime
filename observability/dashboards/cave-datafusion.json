{
  "title": "cave-datafusion",
  "uid": "cave-datafusion",
  "tags": ["cave", "data-persistence", "datafusion", "query-engine"],
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {"id": 1, "title": "Queries/sec", "type": "graph", "targets": [{"expr": "rate(cave_datafusion_queries_total[5m])"}]},
    {"id": 2, "title": "Query exec time p99 (ms)", "type": "graph", "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(cave_datafusion_query_duration_seconds_bucket[5m]))) * 1000"}]},
    {"id": 3, "title": "Plan compile time p99 (ms)", "type": "graph", "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(cave_datafusion_plan_duration_seconds_bucket[5m]))) * 1000"}]},
    {"id": 4, "title": "Errors/sec", "type": "graph", "targets": [{"expr": "rate(cave_datafusion_errors_total[5m])"}]},
    {"id": 5, "title": "Memory usage (bytes)", "type": "graph", "targets": [{"expr": "cave_datafusion_memory_used_bytes"}]},
    {"id": 6, "title": "Registered tables", "type": "stat", "targets": [{"expr": "cave_datafusion_tables_registered"}]},
    {"id": 7, "title": "Optimizer rule hits/min", "type": "graph", "targets": [{"expr": "sum by (rule) (rate(cave_datafusion_optimizer_rule_hits_total[1m])) * 60"}]},
    {"id": 8, "title": "Scan throughput (rows/s)", "type": "graph", "targets": [{"expr": "rate(cave_datafusion_scan_rows_total[5m])"}]},
    {"id": 9, "title": "Cache hits/sec", "type": "graph", "targets": [{"expr": "rate(cave_datafusion_cache_hits_total[5m])"}]},
    {"id": 10, "title": "Partitions read/sec", "type": "graph", "targets": [{"expr": "rate(cave_datafusion_partitions_read_total[5m])"}]}
  ]
}
